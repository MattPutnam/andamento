{
  "name": "andamento-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/svg",
    "packages/react",
    "apps/playground"
  ],
  "scripts": {
    "build": "npm run build -w @andamento/core && npm run build -w @andamento/svg && npm run build -w @andamento/react",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w playground"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
