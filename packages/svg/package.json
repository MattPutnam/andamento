{
  "name": "@andamento/svg",
  "version": "0.2.0",
  "description": "Render @andamento/core layouts to SVG strings or DOM elements.",
  "keywords": [
    "tiling",
    "tessellation",
    "layout",
    "mosaic",
    "grid",
    "gallery",
    "photo-wall",
    "hexagon",
    "herringbone",
    "penrose",
    "voronoi",
    "svg",
    "canvas",
    "png"
  ],
  "homepage": "https://mattputnam.github.io/andamento/",
  "bugs": {
    "url": "https://github.com/MattPutnam/andamento/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattPutnam/andamento.git",
    "directory": "packages/svg"
  },
  "license": "MIT",
  "author": "Matt Putnam",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@andamento/core": "0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
