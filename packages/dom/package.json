{
  "name": "@andamento/dom",
  "version": "0.1.0",
  "description": "Framework-free @andamento tiling layouts: mount one into any element, or use the <andamento-layout> web component.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": { "@andamento/core": "0.1.0", "@andamento/svg": "0.1.0" }
}
