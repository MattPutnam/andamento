{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "examples": "vite-node scripts/examples.ts",
    "dev": "npm run examples && npm run api && vitepress dev",
    "build": "npm run examples && npm run api && vitepress build && npm run playground",
    "playground": "vite build ../apps/playground --base /andamento/playground/ --outDir ../../docs/.vitepress/dist/playground --emptyOutDir",
    "preview": "vitepress preview",
    "api": "typedoc",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@andamento/core": "0.1.0",
    "@andamento/svg": "0.1.0",
    "@andamento/vue": "0.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.2",
    "vite-node": "^2.1.8",
    "vitepress": "^1.6.3"
  }
}
